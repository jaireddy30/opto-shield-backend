[Unit]
Description=Optox Shield AI Security & Telemetry Engine (Backend)
After=network.target asterisk.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/opto-shield-backend
ExecStart=/home/ubuntu/opto-shield-backend/venv/bin/python src/monitor.py
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
